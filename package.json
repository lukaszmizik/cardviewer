{
  "name": "tacho-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "parser": "go run -C ./server/ddd-http .",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "node scripts/build-wasm.mjs && vite build",
    "test:work-periods": "node --experimental-strip-types --test scripts/verify-work-periods.ts",
    "test:card-present-edges": "node --experimental-strip-types --test scripts/verify-card-present-edges.ts",
    "test:work-period-integration": "node --experimental-strip-types --test scripts/verify-work-period-integration.ts",
    "test:work-period-diagnostics": "node --experimental-strip-types --test scripts/verify-work-period-diagnostics.ts",
    "test:holder-timeline": "node --experimental-strip-types --test scripts/verify-holder-timeline.ts scripts/verify-holder-absent-span-diagnostics.ts",
    "test:daily-record-coverage": "node --experimental-strip-types --test scripts/verify-daily-record-coverage.ts scripts/verify-daily-record-coverage-integration.ts",
    "test:work-period-coverage-overlap": "node --experimental-strip-types --test scripts/verify-work-period-coverage-overlap.ts",
    "test:work-period-presentation": "node --experimental-strip-types --test scripts/verify-work-period-presentation.ts",
    "test:qualified-rest-boundaries": "node --experimental-strip-types --test scripts/verify-qualified-rest-boundaries.ts",
    "test:gn7-control-periods": "node --experimental-strip-types --test scripts/verify-gn7-control-periods.ts",
    "test:gn7-diagnostics": "node --experimental-strip-types --test scripts/verify-gn7-diagnostics.ts",
    "test:ferry-rest": "node --experimental-strip-types --test scripts/verify-ferry-rest-candidates.ts",
    "test:gn7-ferry-compliance": "node --experimental-strip-types --test scripts/verify-gn7-ferry-compliance.ts",
    "test:reduced-daily-rest": "node --experimental-strip-types --test scripts/verify-reduced-daily-rest-limit.ts",
    "test:out-mode-graph": "node --experimental-strip-types --test scripts/verify-out-mode-graph.ts",
    "test:out-of-scope": "node --experimental-strip-types --test scripts/verify-out-of-scope.ts",
    "test:card-holder": "node --experimental-strip-types --test scripts/verify-card-holder.ts",
    "test:session-cache": "node --experimental-strip-types --test scripts/verify-session-cache.ts",
    "diagnose:work-periods": "tsx scripts/diagnose-work-periods.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^29.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
